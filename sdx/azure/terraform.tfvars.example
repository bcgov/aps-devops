# Copy this file to terraform.tfvars and fill in the required values.

# Azure placement
resource_group_name = "sdx-edge-rg"
location            = "canadacentral"

# BC Gov Landing Zone pre-provisions one VNet per Project Set — do not create a new one.
# Find yours with: az network vnet list --output table
vnet_name                = "REPLACE_ME"   # e.g. "Project_Set_Name-dev-vnet"
vnet_resource_group_name = "REPLACE_ME"   # often the same as resource_group_name, or a separate network RG

# AKS cluster
cluster_name       = "sdx-edge-aks"
node_count         = 2
vm_size            = "Standard_D1s_v2"
kubernetes_version = null   # null = latest stable

# SDX Edge identity
edge_id   = "my-edge"       # becomes <edge_id>.servers.sdx and the Helm release name
namespace = "sdx-edge"

# Required: one-time token obtained from the SDX CA portal
sdx_bootstrap_token = "REPLACE_ME"

# SDX control plane endpoints (defaults point to the BC Gov dev environment)
sdx_control_url    = "sdx-cluster-api-gov-bc-ca.dev.api.gov.bc.ca:443"
client_ca_url      = "https://sdx-ca-api-gov-bc-ca.dev.api.gov.bc.ca"
sdx_aggregator_url = "gwaggregator-api-gov-bc-ca.dev.api.gov.bc.ca"

# Set to false only when testing without client certificate enforcement
mtls_required = true

# Optional HTTP proxy (leave empty string to disable)
https_proxy = ""


# Subnet CIDRs — must be within the Landing Zone VNet address space.
# Find your VNet range: az network vnet show --name <vnet> --resource-group <rg> --query addressSpace
aks_subnet_cidr   = "REPLACE_ME"   # e.g. a /26 within your /24 allocation
appgw_subnet_cidr = "REPLACE_ME"   # e.g. a /28 within your /24 allocation
aca_subnet_cidr   = "REPLACE_ME"   # /27 minimum; delegated to Microsoft.App/environments

# Kubernetes service/DNS CIDRs — must be in BC Gov approved range, must not overlap the VNet.
pod_cidr       = "10.10.0.0/18"    # BC Gov approved range; used by Azure CNI Overlay
service_cidr   = "10.10.64.0/22"   # BC Gov approved range
dns_service_ip = "10.10.64.10"

# Application Gateway sizing (WAF_v2 required by BC Gov Azure Landing Zone)
appgw_sku      = "WAF_v2"
appgw_capacity = 1

tags = {
  project    = "sdx-edge"
  managed_by = "terraform"
  environment = "dev"
}
