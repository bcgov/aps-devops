meta {
  name: New Subsystem
  type: http
  seq: 3
}

put {
  url: {{BASE}}/organizations/:org/subsystems
  body: json
  auth: inherit
}

params:path {
  org: {{ORG}}
}

body:json {
  {
    "name": "TESTER"
  }
}

vars:pre-request {
