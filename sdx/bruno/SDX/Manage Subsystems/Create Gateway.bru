meta {
  name: Create Gateway
  type: http
  seq: 9
}

put {
  url: {{BASE}}/organizations/:org/subsystems/:subsystem/gateway
  body: json
  auth: inherit
}

params:path {
  subsystem: SDG
  org: {{ORG}}
}

body:json {
  {
    "runtimeGroupName": "abc01"
  }
}

body:multipart-form {
  runtimeGroupName: tempedge
}

vars:pre-request {
  SERVER: https://api-gov-bc-ca.dev.api.gov.bc.ca/ds/api/sdx/v1
}

settings {
  encodeUrl: true
  timeout: 0
}
