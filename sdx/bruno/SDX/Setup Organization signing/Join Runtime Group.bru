meta {
  name: Join Runtime Group
  type: http
  seq: 3
}

put {
  url: {{BASE}}/organizations/:org/gateway
  body: json
  auth: inherit
}

params:path {
  org: {{ORG}}
}

body:json {
  {
    "runtimeGroupName": "stoomedg"
  }
}

body:multipart-form {
  runtimeGroupName: tempedge
}

vars:pre-request {
  SERVER: https://api-gov-bc-ca.dev.api.gov.bc.ca/ds/api/sdx/v1
}

settings {
  encodeUrl: true
  timeout: 0
}
