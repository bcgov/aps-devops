meta {
  name: List My Organization Clients
  type: http
  seq: 4
}

get {
  url: {{BASE}}/organizations/:org/clients
  body: none
  auth: inherit
}

params:path {
  org: {{ORG}}
}

vars:pre-request {
  SERVER: https://api-gov-bc-ca.dev.api.gov.bc.ca/ds/api/sdx/v1
}

settings {
  encodeUrl: true
  timeout: 0
}
