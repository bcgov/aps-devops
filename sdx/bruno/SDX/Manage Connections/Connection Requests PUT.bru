  org: {{ORG}}
}

body:json {
  {
    "clientId": "LAB.MIN.CITZ.DATA-USAGE-TOOL",
    "serviceId": "LAB.MIN.CITZ.DATA-USAGE.v1",
    "isApproved": true,
    "isActive": true
  
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
