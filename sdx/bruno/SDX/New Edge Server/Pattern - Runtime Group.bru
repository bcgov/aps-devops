meta {
  name: Pattern - Runtime Group
  type: http
  seq: 4
}

put {
  url: {{BASE}}/organizations/:org/pattern?action=apply&dryRun=true
  body: json
  auth: inherit
}

params:query {
  action: apply
  dryRun: true
}

params:path {
  org: {{ORG}}
}

body:json {
  {
    "pattern": "sdx-runtime-group.r1",
    "parameters": {
      "runtime_group_name": "pukiedge"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
