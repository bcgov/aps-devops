meta {
  name: New Runtime Group
  type: http
  seq: 1
}

put {
  url: {{BASE}}/organizations/:org/runtime-groups
  body: json
  auth: inherit
}

params:path {
  org: {{ORG}}
}

body:json {
  {
    "sdxEndpoint": "https://142.34.194.118:443",
    "consumerEndpoint": "https://sdx.api.gov.bc.ca:443",
    "name": "abc01",
    "hostedOrganizations": [
      "ministry-of-books"
    ]
  }
}

vars:pre-request {
  SERVER: https://api-gov-bc-ca.dev.api.gov.bc.ca/ds/api/sdx/v1
}

settings {
  encodeUrl: true
  timeout: 0
}
