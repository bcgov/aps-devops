meta {
  name: Owned Runtime Groups
  type: http
  seq: 2
}

get {
  url: {{BASE}}/organizations/:org/runtime-groups?filter=owned
  body: none
  auth: inherit
}

params:query {
  filter: owned
}

params:path {
  org: {{ORG}}
}

vars:pre-request {
  SERVER: https://api-gov-bc-ca.dev.api.gov.bc.ca/ds/api/sdx/v1
}

settings {
  encodeUrl: true
  timeout: 0
}
